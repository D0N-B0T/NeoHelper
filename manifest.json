{
  "manifest_version": 3,
  "name": "Mu Online Toolkit",
  "version": "7.3",
  "action": {
    "default_title": "Mu Online Toolkit"
  },
  "description": "Toolkit for Mu Online",
  "permissions": [
    "debugger",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "sidePanel",
    "unlimitedStorage"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mu.mormon.garden/*"
      ],
      "js": [
        "interceptor.js",
        "esp.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.mu.mormon.garden/*"
      ],
      "js": [
        "content/_bus.js",
        "content/cfg.js",
        "content/routes.js",
        "content/radar.js",
        "content/autowalk.js",
        "content/mobs.js",
        "content/hunt.js",
        "content/stats.js",
        "content/esp-bridge.js",
        "content/auto.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "radar.html",
        "radar.js",
        "radar.css"
      ],
      "matches": [
        "*://*.mu.mormon.garden/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}